[global]
    # Placement & Dynamic Dimensions
    origin = top-right
    offset = (10, 10)
    width = (0, 400)
    height = (0, 200)
    scale = 0
    notification_limit = 5

    # Progress bar (for downloads, volume, brightness)
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 0
    progress_bar_max_width = 400
    progress_bar_corner_radius = 0
    progress_bar_horizontal_alignment = center

    # Spacing & Borders
    padding = 10
    horizontal_padding = 10
    text_icon_padding = 10
    frame_width = 2
    gap_size = 10
    separator_height = 2
    corner_radius = 0

    # Typography & Content Wrapping
    font = JetBrainsMono Nerd Font 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = false
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = true

    # Icons
    enable_recursive_icon_lookup = true
    icon_theme = YAMIS, breeze-dark, Adwaita, hicolor
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    # History & Interactions
    sticky_history = true
    history_length = 20
    dmenu = /usr/bin/rofi -dmenu -p 'Notification Action:'
    browser = /usr/bin/xdg-open

    # Mouse actions
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    # Wayland Layer Shell
    layer = overlay
    force_xwayland = false
    force_xinerama = false

[urgency_low]
    timeout = 3

[urgency_normal]
    timeout = 5

[urgency_critical]
    timeout = 0
